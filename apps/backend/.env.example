# Copy this to .env and fill in your values
NODE_ENV=development
PORT=4000

# PostgreSQL (Supabase)
DATABASE_URL="postgresql://postgres:gandibhavana123@db.amyhriepefnkhitxolle.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:gandibhavana123@db.amyhriepefnkhitxolle.supabase.co:5432/postgres"

# Redis (local via Docker)
REDIS_URL=redis://localhost:6379

# Elasticsearch (local via Docker)
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth - Get from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Session secret - Change this!
SESSION_SECRET=change-me-to-something-random-and-long

# Ethereal Email - Create at https://ethereal.email
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Slack OAuth - Get from Slack App settings
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# Worker configuration
WORKER_CONCURRENCY=10
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Frontend URL
FRONTEND_URL=http://localhost:3000
